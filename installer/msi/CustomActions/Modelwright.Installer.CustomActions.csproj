<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MSI's custom actions (installer/msi/Modelwright.wxs): register and unregister the add-in as Excel's next
    free OPEN/OPENn value, exactly as install/install.ps1 and install/uninstall.ps1 do, and check that Excel is
    closed, 64-bit, and that .NET Framework 4.8 is present.
    Not part of Modelwright.sln: it is built only by installer/msi/build-msi.ps1, so the main build does not need
    WiX. AddInRegistration.cs is pure logic and is unit-tested by tests/Modelwright.Core.Tests (linked there).
    WixToolset.Dtf.CustomAction packs the output into Modelwright.Installer.CustomActions.CA.dll (MakeSfxCA),
    which the MSI embeds.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Modelwright.Installer</RootNamespace>
    <AssemblyName>Modelwright.Installer.CustomActions</AssemblyName>
    <!-- The custom action host for an x64 package: the 64-bit registry view and a 64-bit process. -->
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
